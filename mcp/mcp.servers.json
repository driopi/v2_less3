{
  "mcpServers": {
    "tavily-remote": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "huggingface-local": {
      "command": "npx",
      "args": [
        "-y",
        "huggingface-mcp-server",
        "--transport",
        "stdio",
        "--api-key",
        "${HUGGINGFACE_API_KEY}"
      ],
      "env": {
        "HUGGINGFACE_API_KEY": "${HUGGINGFACE_API_KEY}"
      }
    }
  }
}
